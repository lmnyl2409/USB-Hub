sName" type="button" class="color" style="width:40px;background-color:#fff" value="#FFFFFF">&nbsp;</button></div><div style="margin-bottom:4px"><span class="i18n" data-i18n-context="theme" i18n="Sheet">Sheet</span> <button data-key="sheet" type="button" class="color" style="width:40px;background-color:#fff" value="#FFFFFF">&nbsp;</button></div><div style="margin-bottom:4px"><span class="i18n" i18n="Draw">Draw</span> <button data-key="draw" type="button" class="color" style="width:40px;background-color:#fff" value="#FFFFFF">&nbsp;</button></div><div style="margin-bottom:4px"><span class="i18n item-child" i18n="Fill">Fill</span> <button data-key="drawFill" type="button" class="color" style="width:40px;background-color:#fff" value="#FFFFFF">&nbsp;</button></div><div style="margin-bottom:4px"><span class="i18n" i18n="Arrow">Arrow</span> <button data-key="arrow" type="button" class="color" style="width:40px;background-color:#fff" value="#FFFFFF">&nbsp;</button></div><div style="margin-bottom:4px"><span class="i18n" i18n="Junction">Junction</span> <button data-key="junction" type="button" class="color" style="width:40px;background-color:#c00" value="#CC0000">&nbsp;</button></div></div></div><div id="dlg-theme-setting-apply-setting" class="dialog-theme-tab"><div style="padding-bottom:5px"><span class="i18n" i18n="Apply &#39;Custom Theme&#39; On:">Apply 'Custom Theme' On:</span></div><div style="display:flex;flex-direction:column"><div style="padding:5px 20px 0 5px"><input id="dlg-theme-new-schematic" type="checkbox" style="vertical-align:middle"><label for="dlg-theme-new-schematic" class="i18n" i18n="Creating New Schematic">Creating New Schematic</label></div><div style="padding:5px 5px 0 5px"><input id="dlg-theme-opening-existed" type="checkbox" style="vertical-align:middle"><label for="dlg-theme-opening-existed" class="i18n" i18n="Opening Existed Schematic">Opening Existed Schematic</label></div></div></div></div></div></div><div id="histories-list" class="easyui-dialog"