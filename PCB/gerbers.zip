ox" checked="" name="Manufacturer Part" title="Manufacturer Part"><span class="i18n" i18n="Manufacturer Part">Manufacturer Part</span></label><label><input type="checkbox" checked="" name="Manufacturer" title="Manufacturer"><span class="i18n" i18n="Manufacturer">Manufacturer</span></label><label><input type="checkbox" checked="" name="Supplier" title="Supplier"><span class="i18n" i18n="Supplier">Supplier</span></label><label><input type="checkbox" checked="" name="Supplier Part" title="Supplier Part"><span class="i18n" i18n="Supplier Part">Supplier Part</span></label><label><input type="checkbox" checked="" name="Price" title="Price"><span class="i18n" i18n="Price">Price</span></label><label><input type="checkbox" name="Pins" title="Pins"><span class="i18n" i18n="Pins">Pins</span></label></div><div class="item custom-columns" title="Custom Properties" data-i18n-attr="title"></div></div></div></div><div id="fingerprint-search" class="easyui-dialog" title="Find System Similar Footprint" style="width:800px;height:538px" closed="true"><fieldset class="find-params"><legend class="i18n" i18n="Find Parameters">Find Parameters</legend><div class="params"></div></fieldset><fieldset class="find-results"><legend class="i18n" i18n="Find Results">Find Results</legend><div class="results"></div></fieldset><div class="copy"><textarea class="hidden" id="fingerprint-search-copy-area"></textarea><div class="item hidden"><div class="view"><img alt="" src="https://easyeda.com/editor"></div><div class="datas"><div class="title"></div><div class="btns"><a href="https://easyeda.com/editor#" style="margin-right:10px" class="l-btn" action="open"><span class="l-btn-left"><span class="l-btn-text i18n" i18n="Open">Open</span></span></a> <a href="https://easyeda.com/editor#" class="l-btn" action="copy"><span class="l-btn-left"><span class="l-btn-text i18n" i18n="Copy Title">Copy Title</span></span></a></div></div></div></div></div><div id="migrate-to-pro" class="easyui-dialog" title="Migrate to