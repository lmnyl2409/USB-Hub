check="false" autocomplete="off" readonly="readonly"></textarea></div><div id="dlgCreateLeadShapeOnPad" class="easyui-dialog" closed="true" title="Create Lead Shape" style="padding:10px;width:550px;height:400px"><p><span class="i18n" i18n="Lead shape">Lead shape</span>: &nbsp;<label><input type="radio" value="rect" name="lead-shape-type" checked="checked"><span class="i18n" i18n="Rectangle">Rectangle</span></label>&nbsp;<label><input type="radio" value="circle" name="lead-shape-type"><span class="i18n" i18n="Circle">Circle</span></label>&nbsp;<label><input type="radio" value="pad" name="lead-shape-type"><span class="i18n" i18n="From pad shape">From pad shape</span></label></p><div data-type="rect" style="margin-left:40px"><table cellpadding="0" cellspacing="10"><tbody><tr><td><span class="i18n" i18n="Lead length">Lead length</span>(L):</td><td><input type="text" data-id="LeadLength" size="10"> <span data-id="unit"></span></td></tr><tr><td><span class="i18n" i18n="Lead width">Lead width</span>(W):</td><td><input type="text" data-id="LeadWidth" size="10"> <span data-id="unit"></span></td></tr></tbody></table><p style="margin-left:20px"><img src="./gerbers_files/create-lead-shape-rectangle.png" style="width:400px"></p></div><div data-type="circle" style="margin-left:40px;display:none"><span class="i18n" i18n="Lead diameter">Lead diameter</span>(D): <input type="text" data-id="LeadDiameter" size="10"> <span data-id="unit"></span><p style="margin-left:20px"><img src="./gerbers_files/create-lead-shape-circle.png" style="width:400px"></p></div><div data-type="pad" style="margin-left:40px;display:none"><span class="i18n" i18n="Scaling ratio">Scaling ratio</span>: <input type="text" data-id="ScalingRatio" size="10" value="1"></div></div><div id="dlgCreateLeadShape" class="easyui-dialog" closed="true" title="Create Lead Shape" style="padding:10px;width:550px"><table cellpadding="0" cellspacing="10"><tbody><tr><td><span class="i18n" i18n="Footprint Type">Footprint Type</span>:</td><td><select data-id="FootprintType"><option class="i18n" value="SOP" selected="selected" i18n="SOP">SOP</option><option class="i18n" value="DIP" i18n="DIP">DIP</option></select></td></tr><tr><td><span class="i18n" i18n="Leads creating direction">Leads creating direction</span>:</td><td><select data-id="LeadsDirection"><option class="i18n" value="auto" selected="selected" i18n="Auto">Auto</option><option class="i18n" value="h" i18n="Horizontal">Horizontal</option><option class="i18n" value="v" i18n="Vertical">Vertical</option></select></td></tr><tr><td><span class="i18n" i18n="Canvas origin to lead edge">Canvas origin to lead edge</span>(L1):</td><td><input type="text" data-id="ToLeadEdge" size="10" value="1"> <span data-id="unit"></span></td></tr><tr><td><span class="i18n" i18n="Canvas origin to body edge">Canvas origin to body edge</span>(L2):</td><td><input type="text" data-id="ToBodyEdge" size="10" value="1"> <span data-id="unit"></span></td></tr><tr data-for="SOP"><td><span class="i18n" i18n="Lead soldering length">Lead soldering length</span>(L3):</td><td><input type="text" data-id="SolderingLength" size="10" value="1"> <span data-id="unit"></span></td></tr><tr data-for="DIP" style="display:none"><td><span class="i18n" i18n="Lead soldering part diameter">Lead soldering part diameter</span>(D):</td><td><input type="text" data-id="SolderingDiameter" size="10" value="1"> <span data-id="unit"></span></td></tr><tr><td><span class="i18n" i18n="Lead width">Lead width</span>(W):</td><td><input type="text" data-id="LeadWidth" size="10" value="1"> <span data-id="unit"></span></td></tr></tbody></table><div class="img" style="margin-left:20px"><img src="./gerbers_files/create-lead-shape-canvas.png" data-for="SOP" style="width:200px"> <img src="./gerbers_files/creat-lead-shape-dip.png" data-for="DIP" style="width:280px;display:none"></div></div><div id="footprintWizard-pre" class="easyui-dialog" title="Footprint Wizard" resizable="true" style="width:1046px;height:670px